from dataclasses import dataclass
import os


@dataclass(frozen=True)
class Config:
    postgres_host: str
    postgres_port: int
    postgres_user: str
    postgres_password: str
    postgres_db: str
    rabbitmq_host: str
    rabbitmq_port: int
    rabbitmq_user: str
    rabbitmq_password: str
    rabbitmq_queue: str

    @property
    def database_url(self) -> str:
        return (
            f"postgresql+psycopg://{self.postgres_user}:"
            f"{self.postgres_password}@{self.postgres_host}:"
            f"{self.postgres_port}/{self.postgres_db}"
        )


def get_config() -> Config:
    return Config(
        postgres_host=os.environ["BILLING_POSTGRES_HOST"],
        postgres_port=int(os.environ["BILLING_POSTGRES_PORT"]),
        postgres_user=os.environ["BILLING_POSTGRES_USER"],
        postgres_password=os.environ["BILLING_POSTGRES_PASSWORD"],
        postgres_db=os.environ["BILLING_POSTGRES_DB"],
        rabbitmq_host=os.environ["BILLING_RABBITMQ_HOST"],
        rabbitmq_port=int(os.environ["BILLING_RABBITMQ_PORT"]),
        rabbitmq_user=os.environ["BILLING_RABBITMQ_USER"],
        rabbitmq_password=os.environ["BILLING_RABBITMQ_PASSWORD"],
        rabbitmq_queue=os.environ.get("BILLING_RABBITMQ_QUEUE", "billing_queue"),
    )
