{
  "title": "Cloud-Design Overview",
  "uid": "cloud-design-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["cloud-design", "kubernetes"],
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (job) (rate(http_requests_total{job=~\"api-gateway-app|inventory-app|billing-app\"}[5m]))", "legendFormat": "{{job}}" }
      ]
    },
    {
      "title": "HTTP 5xx Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (job) (rate(http_requests_total{job=~\"api-gateway-app|inventory-app|billing-app\",status=~\"5..\"}[5m]))", "legendFormat": "{{job}}" }
      ]
    },
    {
      "title": "Service Availability",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "label_replace((kube_deployment_status_replicas_ready{namespace=\"default\",deployment=~\"api-gateway-app|inventory-app|rabbitmq\"} > bool 0), \"job\", \"$1\", \"deployment\", \"(.*)\") or label_replace((kube_statefulset_status_replicas_ready{namespace=\"default\",statefulset=\"billing-app\"} > bool 0), \"job\", \"$1\", \"statefulset\", \"(.*)\")", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "title": "Pod CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"default\",container!=\"\"}[5m]))", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "title": "RabbitMQ Ready Messages",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "max by (queue) (rabbitmq_queue_messages_ready)", "legendFormat": "ready messages" }
      ]
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser"
}
